# ── ML / Data artifacts (generated — do not commit) ──────────────────────────
# Embeddings & index files (regenerated by build_embeddings.py + build_index.py)
data/idiom_embeddings.npy
data/**/*.npy
data/**/*.npz
data/**/*.index
data/**/*.bin
data/**/*.pkl

# Processed dataset (generated by src/rebuild_dataset.py)
# Track only the source / seed data, not the generated CSV
data/processed/idioms_with_phonetic_keys.csv
data/processed/idioms_with_phonetic_keys_*_backup.csv
data/processed/word_vocab_cache.npz
data/processed/index/

# ── Custom-trained model weights (large binary files) ────────────────────────
# The full model checkpoint lives here — too large for git (900 MB+).
# Regenerate with: py server-nlp/scripts/train_model.py
models/konkan-vani-encoder-v1/

# Training artefacts (keep benchmark_report.json and loss curve — they are small
# and useful for evaluation; exclude only the checkpoint directory above)
# models/benchmark_report.json  ← tracked intentionally (evaluation evidence)
# models/training_loss_curve.png ← tracked intentionally

# ── Intermediate training checkpoints ─────────────────────────────────────────
# HuggingFace / sentence-transformers mid-run checkpoints
checkpoints/

# ── Hugging Face cache (if redirected into project dir) ──────────────────────
.cache/
huggingface/
